{
  "name": "blackout-protocol-mobile",
  "private": true,
  "version": "0.1.0",
  "description": "Blackout Protocol — mobile multiplayer co-op tactical heist game",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm install --workspaces --include-workspace-root",
    "build:shared": "npm run build --workspace=shared",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build": "npm run build:shared && npm run build:server && npm run build:client",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "start:server": "npm run start --workspace=server",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up",
    "deploy:fly": "bash scripts/deploy-fly.sh",
    "clean": "rm -rf */dist */node_modules node_modules"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20"
  }
}
